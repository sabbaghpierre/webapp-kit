#!/usr/bin/env bash
# webapp-launch-firefox — launch a URL in a self-contained (ice-ssb style)
# Firefox profile with an app-like UI: tab strip removed, titlebar keeps only
# the minimize/maximize/close buttons plus drag space.
#
# Isolation model (like ice-ssb, whose Firefox SSBs are ALWAYS isolated):
#   firefox --profile ~/.local/share/webapps/firefox-<slug> --no-remote <url>
# The profile dir is app-owned: no profiles.ini bookkeeping, rm -rf purges it.
#
# Wayland identity: --name sets the Wayland app_id, which must equal the slug
# (and StartupWMClass in the .desktop). --class covers X11/XWayland.
#
# Usage:
#   webapp-launch-firefox --name "My App" --url "https://example.com"
#   webapp-launch-firefox "https://example.com"
#   A trailing URL-like positional (e.g. %u from a MimeType handler) overrides --url.
set -euo pipefail

# Never inherit a hostile field separator/glob config.
unset IFS GLOBIGNORE

# --version source of truth: $PREFIX/VERSION shipped by install.sh.
cmd_version() {
  local d
  d="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  if [[ -f "$d/../VERSION" ]]; then
    cat "$d/../VERSION"
  else
    printf 'dev'
  fi
}

NAME=""
URL=""
EXTRA=()

usage() {
  echo "Usage: webapp-launch-firefox --name \"My App\" --url \"https://example.com\""
}

slugify() {
  local s="$1"
  s="${s// /-}"
  s="$(printf '%s' "$s" | tr -c '[:alnum:]-_.' '-')"
  s="$(printf '%s' "$s" | sed -e 's/-\{2,\}/-/g' -e 's/^[-.]//' -e 's/[-.]$//')"
  [[ -z "$s" ]] && s="webapp"
  printf '%s' "$s"
}

while (($# > 0)); do
  case "$1" in
    --name) NAME="${2:?--name needs a value}"; shift 2 ;;
    --url) URL="${2:?--url needs a value}"; shift 2 ;;
    -h | --help) usage; exit 0 ;;
    --version) printf '%s %s\n' "$(basename "$0")" "$(cmd_version)"; exit 0 ;;
    --) shift; while (($# > 0)); do EXTRA+=("$1"); shift; done; break ;;
    --*) echo "webapp-launch-firefox: unknown flag: $1" >&2; usage >&2; exit 1 ;;
    *)
      if [[ -z "$URL" ]]; then URL="$1"; else EXTRA+=("$1"); fi
      shift
      ;;
  esac
done

if ((${#EXTRA[@]} > 0)); then
  last="${EXTRA[${#EXTRA[@]} - 1]}"
  if [[ "$last" =~ ^[a-zA-Z][a-zA-Z0-9+.-]*: ]]; then
    URL="$last"
    unset 'EXTRA[${#EXTRA[@]}-1]'
  fi
fi

if [[ -z "$URL" ]]; then
  echo "webapp-launch-firefox: no URL given" >&2
  usage >&2
  exit 1
fi
if [[ ! "$URL" =~ ^[a-zA-Z][a-zA-Z0-9+.-]*: ]]; then
  URL="https://$URL"
fi

if [[ -z "$NAME" ]]; then
  host="${URL#*://}"
  host="${host%%/*}"
  NAME="$host"
fi
SLUG="$(slugify "$NAME")"

if ! command -v firefox >/dev/null 2>&1; then
  echo "webapp-launch-firefox: firefox not found on PATH" >&2
  exit 1
fi

DATA_ROOT="$HOME/.local/share/webapps"
PDIR="$DATA_ROOT/firefox-${SLUG}"
LOG_FILE="$DATA_ROOT/${SLUG}.log"

log() {
  printf '[%s] %s\n' "$(date '+%F %T')" "$*" >>"$LOG_FILE" 2>/dev/null || true
}

mkdir -p "$PDIR/chrome"
log "launch name='$NAME' slug='$SLUG' url='$URL' profile='$PDIR' extra='${EXTRA[*]:-}'"

# stylesheets pref (idempotent)
PREF='user_pref("toolkit.legacyUserProfileCustomizations.stylesheets", true);'
touch "$PDIR/user.js"
if ! grep -qF 'toolkit.legacyUserProfileCustomizations.stylesheets' "$PDIR/user.js"; then
  printf '%s\n' "$PREF" >>"$PDIR/user.js"
  log "enabled userChrome stylesheets pref"
fi

# minimal UI stylesheet: v3 keeps window controls, strips tab strip contents.
CSS="$PDIR/chrome/userChrome.css"
write_v3_css() {
  cat >"$1" <<'EOF'
/* webapp minimal UI v3 — auto-generated by webapp-launch-firefox; safe to edit */
/* Titlebar keeps ONLY window controls + drag space. #TabsToolbar itself must
   stay visible: on Linux CSD the min/max/close buttons live inside it. */
#TabsToolbar > *:not(.titlebar-buttonbox-container):not(.titlebar-spacer) {
  display: none !important;
}
#tabbrowser-tabs,
#tabbrowser-arrowscrollbox,
#alltabs-button,
#new-tab-button,
#tabs-newtab-button {
  display: none !important;
}
/* Browser chrome we never want in app mode (nav-bar holds the hamburger
   menu and extension buttons, so hiding it removes those too). */
#nav-bar,
#PersonalToolbar,
#statuspanel,
#sidebar-box,
#sidebar-header {
  visibility: collapse !important;
}
/* popup-reveal v1: permission doorhangers anchor inside #nav-bar, so reveal
   it while hovered, keyboard-focused, or while any arrow panel (e.g. the
   doorhanger itself) is open — otherwise prompts misposition into an
   unclickable loop. Sibling order mainPopupSet→toolbox and panelopen-on-
   arrow-panels both verified against this Firefox build's DOM. Hover the
   top edge and click Allow once; the grant ends any retry loop for good. */
#navigator-toolbox:is(:hover, :focus-within) #nav-bar,
#mainPopupSet:hover ~ #navigator-toolbox #nav-bar,
#mainPopupSet:has(> [panelopen]) ~ #navigator-toolbox #nav-bar {
  visibility: visible !important;
}
:root[sizemode="normal"] #toolbar-menubar {
  visibility: collapse !important;
}
#toolbar-menubar[autohide="false"] {
  visibility: visible !important;
}
EOF
}
if [[ ! -f "$CSS" ]]; then
  write_v3_css "$CSS"
  log "wrote minimal-UI v3 css"
elif ! grep -q 'popup-reveal v1' "$CSS"; then
  if grep -q 'auto-generated by webapp-launch-firefox' "$CSS"; then
    cp -f "$CSS" "$CSS.webapp-bak" || true
    write_v3_css "$CSS"
    log "migrated css to v3+popup-reveal (backup at $CSS.webapp-bak)"
  else
    log "custom userChrome.css detected; left untouched"
  fi
fi

# Warn (don't abort) when another Firefox instance already holds this
# profile: the new window may fail or skip fresh settings, and the error
# would otherwise vanish behind setsid. (pgrep never matches itself.)
if command -v pgrep >/dev/null 2>&1 && pgrep -f -- "--profile $PDIR" >/dev/null 2>&1; then
  echo "webapp-launch-firefox: warning: profile $PDIR looks already in use;" >&2
  echo "  close that Firefox window first or this launch may fail silently." >&2
  log "warning: profile already in use"
fi

log "exec: env MOZ_ENABLE_WAYLAND=1 firefox --no-remote --profile $PDIR --new-window --name $SLUG --class $SLUG $URL ${EXTRA[*]:-}"
# --no-remote allows this profile to run alongside the default Firefox instance.
# MOZ_ENABLE_WAYLAND=1 forces the native Wayland backend: under XWayland the
# window can push its own (Firefox logo) icon, overriding the .desktop icon.
exec env MOZ_ENABLE_WAYLAND=1 setsid firefox --no-remote --profile "$PDIR" --new-window --name "$SLUG" --class "$SLUG" "$URL" "${EXTRA[@]}"
