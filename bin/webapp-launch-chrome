#!/usr/bin/env bash
# webapp-launch-chrome — launch a URL as an isolated Chromium SSB window.
# Omarchy equivalent of `omarchy-launch-webapp`, but pinned to a Chromium
# engine with a per-app --user-data-dir (isolated cookies/logins) instead of
# following the xdg default browser (which breaks on Firefox-only systems).
#
# Usage:
#   webapp-launch-chrome --name "My App" --url "https://example.com" [-- extra-chrome-flags...]
#   webapp-launch-chrome "https://example.com" [extra-chrome-flags...]
#   A trailing URL-like positional (e.g. %u from a MimeType handler) overrides --url.
set -euo pipefail

# Never inherit a hostile field separator/glob config.
unset IFS GLOBIGNORE

# --version source of truth: $PREFIX/VERSION shipped by install.sh.
cmd_version() {
  local d
  d="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  if [[ -f "$d/../VERSION" ]]; then
    cat "$d/../VERSION"
  else
    printf 'dev'
  fi
}

NAME=""
URL=""
EXTRA=()

usage() {
  echo "Usage: webapp-launch-chrome --name \"My App\" --url \"https://example.com\" [-- extra-chrome-flags...]"
}

slugify() {
  local s="$1"
  s="${s// /-}"
  s="$(printf '%s' "$s" | tr -c '[:alnum:]-_.' '-')"
  s="$(printf '%s' "$s" | sed -e 's/-\{2,\}/-/g' -e 's/^[-.]//' -e 's/[-.]$//')"
  [[ -z "$s" ]] && s="webapp"
  printf '%s' "$s"
}

while (($# > 0)); do
  case "$1" in
    --name) NAME="${2:?--name needs a value}"; shift 2 ;;
    --url) URL="${2:?--url needs a value}"; shift 2 ;;
    -h | --help) usage; exit 0 ;;
    --version) printf '%s %s\n' "$(basename "$0")" "$(cmd_version)"; exit 0 ;;
    --) shift; while (($# > 0)); do EXTRA+=("$1"); shift; done; break ;;
    --*) echo "webapp-launch-chrome: unknown flag: $1" >&2; usage >&2; exit 1 ;;
    *)
      if [[ -z "$URL" ]]; then URL="$1"; else EXTRA+=("$1"); fi
      shift
      ;;
  esac
done

# A MimeType handler passes the clicked URL (%u) as an extra positional.
# If the last extra arg looks like a URL scheme, it wins (e.g. mailto: link).
if ((${#EXTRA[@]} > 0)); then
  last="${EXTRA[${#EXTRA[@]} - 1]}"
  if [[ "$last" =~ ^[a-zA-Z][a-zA-Z0-9+.-]*: ]]; then
    URL="$last"
    unset 'EXTRA[${#EXTRA[@]}-1]'
  fi
fi

if [[ -z "$URL" ]]; then
  echo "webapp-launch-chrome: no URL given" >&2
  usage >&2
  exit 1
fi
if [[ ! "$URL" =~ ^[a-zA-Z][a-zA-Z0-9+.-]*: ]]; then
  URL="https://$URL"
fi

if [[ -z "$NAME" ]]; then
  host="${URL#*://}"
  host="${host%%/*}"
  NAME="$host"
fi
SLUG="$(slugify "$NAME")"

CHROME_BIN=""
for c in google-chrome-stable google-chrome chromium chromium-browser brave-browser brave vivaldi-stable vivaldi microsoft-edge-stable opera; do
  if command -v "$c" >/dev/null 2>&1; then CHROME_BIN="$c"; break; fi
done
if [[ -z "$CHROME_BIN" ]]; then
  echo "webapp-launch-chrome: no Chromium-based browser found (tried google-chrome-stable, chromium, brave, vivaldi, edge, opera)" >&2
  exit 1
fi

DATA_DIR="$HOME/.local/share/webapps/chrome-${SLUG}"
mkdir -p "$DATA_DIR"

LOG_FILE="$HOME/.local/share/webapps/${SLUG}.log"
printf '[%s] launch name=%s slug=%s url=%s datadir=%s extra=%s\n' \
  "$(date '+%F %T')" "$NAME" "$SLUG" "$URL" "$DATA_DIR" "${EXTRA[*]:-}" >>"$LOG_FILE" 2>/dev/null || true
printf '[%s] exec: %s --ozone-platform-hint=auto --user-data-dir=%s --class=%s --app=%s %s\n' \
  "$(date '+%F %T')" "$CHROME_BIN" "$DATA_DIR" "$SLUG" "$URL" "${EXTRA[*]:-}" >>"$LOG_FILE" 2>/dev/null || true

# --ozone-platform-hint=auto: run native Wayland under Plasma instead of
# XWayland (XWayland webapp windows can't match .desktop icons: KDE #358277).
# No-op on X11 sessions.
exec setsid "$CHROME_BIN" --ozone-platform-hint=auto --user-data-dir="$DATA_DIR" --class="$SLUG" --app="$URL" "${EXTRA[@]}"
